{
	"deno.enablePaths": [
		"./DevTools/"
	],
    "cSpell.words": [
		"avalonia",
		"benchmarkdotnet",
		"Bufferi",
		"buildtransitive",
		"CASL",
		"cicd",
		"cobertura",
		"codeanalysis",
		"Codecov",
		"communitytoolkit",
		"contentfiles",
		"csharpsquid",
		"deepseek",
		"demilestoned",
		"denoland",
		"editorconfig",
		"ethomson",
		"Finalizers",
		"fluentassertions",
		"gitattributes",
		"ibrary",
		"imagesharp",
		"kdgui",
		"Kinson",
		"kinsondigital",
		"libasound",
		"libopenal",
		"libpipewire",
		"milestoned",
		"msbuild",
		"mvvm",
		"netanalyzers",
		"nint",
		"nsubstitute",
		"nuget",
		"nupkg",
		"openal",
		"ound",
		"pwsh",
		"Reactable",
		"reactables",
		"REPONAME",
		"runsettings",
		"serilog",
		"Shouldly",
		"simpleinjector",
		"sixlabors",
		"softprops",
		"Sourceb",
		"Sourcef",
		"Sourcei",
		"struct",
		"stylecop",
		"udio",
		"Unqueue",
		"Unsubscriber",
		"Vorbis",
		"xunit"
	],
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/bin": true,
		"**/obj": true,
		"**/*.sln.DotSettings.user": true
	},
	"workbench.editor.customLabels.patterns": {
		"**/Testing/**/*Tests.cs": "${filename}🧪",
		"**/CASL/**/*.cs": "${filename}👾",
		"**/DevTools/**/*.ts": "${filename}🔧",
		"**/.github/workflows/**/*.yml": "${filename}⚙️",
		"**/ReleaseNotes/**/*.md": "${filename}📋",
	},
    "dotnet.defaultSolution": "CASL.sln",
    "dotnet.unitTests.runSettingsPath": "Testing/CASL.runsettings",
    "[csharp]": {
		"editor.insertSpaces": true,
		"editor.indentSize": 4,
    },
	"[yaml]": {
		"editor.insertSpaces": true,
		"editor.indentSize": 2,
	},
	"[jsonc]": {
		"editor.insertSpaces": false,
		"editor.indentSize": 4,
	},
	"editor.detectIndentation": false,
	"[github-actions-workflow]": {
		"editor.indentSize": 2,
		"editor.insertSpaces": true
	},
}
